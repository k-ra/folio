# Optional: image and interactive generation. Never use a VITE_ prefix for keys.
OPENAI_API_KEY=
FOLIO_TEXT_MODEL=gpt-6-astra
FOLIO_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional local Claude subscription connection for chat, graphics, data, and backgrounds.
# Uses your existing Claude sign-in. No credentials are copied into Folio.
# FOLIO_TEXT_PROVIDER=claude
# FOLIO_CLAUDE_CLI=/absolute/path/to/claude
# FOLIO_CLAUDE_MODEL=opus
# Images still require OPENAI_API_KEY. This is for local development, not hosting.
