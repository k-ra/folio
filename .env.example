# Local development only. Vercel visitors bring their own key via Connect AI.
# Do not set an owner's AI API key on the public deployment. Never prefix AI/secret keys with VITE_.
OPENAI_API_KEY=
# Optional accounts: these two values are public project configuration, NOT admin credentials.
# Apply supabase/migrations/202609210001_stories.sql before enabling them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring Google OAuth in Supabase; rebuild after changing.
VITE_GOOGLE_AUTH_ENABLED=false
FOLIO_TEXT_MODEL=gpt-6-astra
FOLIO_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional local Claude subscription connection for chat, graphics, data, and backgrounds.
# Uses your existing Claude sign-in. No credentials are copied into Folio.
# FOLIO_TEXT_PROVIDER=claude
# FOLIO_CLAUDE_CLI=/absolute/path/to/claude
# FOLIO_CLAUDE_MODEL=opus
# Images still require OPENAI_API_KEY. This is for local development, not hosting.
