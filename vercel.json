{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "src/assets/image-studies/*.webp"
    }
  }
}
